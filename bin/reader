#!/usr/bin/env python3
"""Reader's backend: finds books and converts them for the reader.

Run as `python3 -B bin/reader <command>`; see backend/reader/cli.py.
"""

import os
import sys

# Nothing may be written inside the plugin directory once it is installed:
# any file appearing there makes the Omarchy shell reload every plugin.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "backend"))

from reader.cli import limit_memory, main  # noqa: E402

if __name__ == "__main__":
    limit_memory()
    sys.exit(main(sys.argv[1:]))
